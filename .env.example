# Only needed for the gpt / groq presets and the LLM-as-judge (the default ollama/phi3 path needs none).
OPENAI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here

# In Docker, compose sets QDRANT_URL and OLLAMA_HOST (default: the host's Ollama via
# host.docker.internal). Set these only to override that, or when running outside Docker.
# QDRANT_URL=http://localhost:6333
# OLLAMA_HOST=http://localhost:11434

# Where benchmark runs are stored / read by the dashboard (default: sqlite:///var/mlflow.db).
# MLFLOW_TRACKING_URI=sqlite:///var/mlflow.db
